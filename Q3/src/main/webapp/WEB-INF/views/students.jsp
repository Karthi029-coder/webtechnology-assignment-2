<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student Portal</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<header class="topbar"><div class="brand"><div class="logo small-logo">K</div><div><b>KPR Institute of Engineering and Technology</b><small>Student Portal</small></div></div><form method="post" action="${pageContext.request.contextPath}/logout"><button class="btn secondary" type="submit">Log out</button></form></header>
<main class="wrap"><span class="eyebrow">ACADEMIC DIRECTORY</span><h1>Student dashboard</h1><p class="muted">Student information loaded dynamically from MySQL.</p>
<div class="toolbar"><input id="studentSearch" type="search" placeholder="Search by name, roll number, email or courseâ€¦" aria-label="Search students"><span id="studentCount" class="muted"></span></div><div class="grid" id="studentGrid"><% List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("students"); if(students.isEmpty()){ %><div class="empty">No student records are available yet. Add records to the students table in MySQL.</div><% } else { for(Map<String,Object> s:students){ String id=String.valueOf(s.get("id")); String name=String.valueOf(s.get("name")); String roll=String.valueOf(s.get("rollNumber")); String email=String.valueOf(s.get("email")); String course=String.valueOf(s.get("course")); String type=String.valueOf(s.get("fileType")); boolean hasFile=s.get("filePath")!=null&&!String.valueOf(s.get("filePath")).isBlank(); %><article class="student-card" data-search="<%= esc((name+" "+roll+" "+email+" "+course).toLowerCase()) %>"><% if(hasFile&&("image/jpeg".equals(type)||"image/png".equals(type))){ %><img class="avatar" src="${pageContext.request.contextPath}/file?id=<%= id %>" alt="Profile image for student"><% } else { %><div class="avatar placeholder">ST</div><% } %><h2><%= esc(name) %></h2><span class="pill"><%= esc(roll) %></span><p><%= esc(email) %></p><p class="course"><%= esc(course) %></p><% if(hasFile&&"application/pdf".equals(type)){ %><a class="doc-link" href="${pageContext.request.contextPath}/file?id=<%= id %>" target="_blank" rel="noopener">View student document â†—</a><% } %></article><% }} %></div><p id="noMatches" class="empty" hidden>No students match that search.</p></main>
<script>
const searchBox=document.getElementById('studentSearch'), cards=[...document.querySelectorAll('.student-card')], countLabel=document.getElementById('studentCount'), noMatches=document.getElementById('noMatches');
function filterStudents(){const q=searchBox.value.toLowerCase().trim();let n=0;cards.forEach(card=>{const show=card.dataset.search.includes(q);card.hidden=!show;if(show)n++;});countLabel.textContent=`${n} student${n == 1?'':'s'}`;noMatches.hidden=n!==0;}
searchBox.addEventListener('input',filterStudents);filterStudents();
</script>
<%! private String esc(String v){return v==null?"":v.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
</body></html>

